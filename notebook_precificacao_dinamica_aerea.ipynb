        "def criar_modelo_mlp_pricing(input_dim=6, learning_rate=0.001, l2_reg=1e-4):\n",
        "    modelo = keras.Sequential(name=\"MLP_Yield_Management\")\n",
        "    \n",
        "    # Camada Oculta 1\n",
        "    modelo.add(layers.Dense(\n",
        "        64, \n",
        "        activation='relu', \n",
        "        input_dim=input_dim, \n",
        "        kernel_regularizer=keras.regularizers.l2(l2_reg),\n",
        "        name=\"dense_1\"\n",
        "    ))\n",
        "    modelo.add(layers.Dropout(0.20, name=\"dropout_1\"))\n",
        "    \n",
        "    # Camada Oculta 2\n",
        "    modelo.add(layers.Dense(\n",
        "        32, \n",
        "        activation='relu', \n",
        "        kernel_regularizer=keras.regularizers.l2(l2_reg),\n",
        "        name=\"dense_2\"\n",
        "    ))\n",
        "    modelo.add(layers.Dropout(0.20, name=\"dropout_2\"))\n",
        "    \n",
        "    # Camada Oculta 3\n",
        "    modelo.add(layers.Dense(16, activation='relu', name=\"dense_3\"))\n",
        "    \n",
        "    # Camada de Saída (Probabilidade de Conversão)\n",
        "    modelo.add(layers.Dense(1, activation='sigmoid', name=\"output_layer\"))\n",
        "    \n",
        "    # Compilação do modelo\n",
        "    optimizer = keras.optimizers.Adam(learning_rate=learning_rate)\n",
        "    modelo.compile(\n",
        "        optimizer=optimizer,\n",
        "        loss='binary_crossentropy',\n",
        "        metrics=['accuracy', tf.keras.metrics.AUC(name='auc')]\n",
        "    )\n",
        "    \n",
        "    return modelo\n",
        "\n",

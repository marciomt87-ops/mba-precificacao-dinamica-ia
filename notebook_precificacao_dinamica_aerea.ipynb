        "---\n",
        "## SEÇÃO 8: Construção do Agente Autônomo de Yield Management / Prescritivo\n",
        "\n",
        "O **Agente de IA Prescritivo** opera sobre o motor de conversão calibrado da Rede Neural. Para uma determinada consulta de voo (caracterizada por `dias_ate_decolagem`, `taxa_ocupacao_atual`, `preco_concorrente`, `historico_buscas_24h` e `dia_da_semana`), o agente varre um espaço contínuo de tarifas ($P_{\\text{candidato}} \\in [R\\$ 250, R\\$ 1800]$) com um **Grid Search em tempo real**.\n",
        "\n",
        "#### Formulação do Problema de Otimização:\n",
        "$$\\max_{p} \\quad \\mathbb{E}[R(p)] = p \\cdot \\hat{P}(\\text{Compra} \\mid p, \\mathbf{x})$$\n",
        "$$\\text{Sujeito a: } \\quad P_{\\min} \\le p \\le P_{\\max} \\quad \\text{e guardrails de ocupação/urgência.}$$"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 9,
      "id": "673f843f",
      "metadata": {
        "execution": {
          "iopub.execute_input": "2026-08-20T22:37:35.323890Z",
          "iopub.status.busy": "2026-08-20T22:37:35.323890Z",
          "iopub.status.idle": "2026-08-20T22:37:35.335919Z",
          "shell.execute_reply": "2026-08-20T22:37:35.335919Z"
        }
      },
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "Agente de IA para Yield Management compilado e operacional!\n"
          ]
        }
      ],
      "source": [
        "class AgenteYieldManagement:\n",
        "    \"\"\"\n",
        "    Agente de IA Prescritivo focado na otimização da Receita Esperada por Assento (Yield Management).\n",
        "    Integra a Rede Neural treinada para inferência em tempo real e calcula a tarifa ótima por Grid Search.\n",
        "    \"\"\"\n",
        "    def __init__(self, modelo_nn, scaler, feature_cols):\n",
        "        self.modelo = modelo_nn\n",
        "        self.scaler = scaler\n",
        "        self.feature_cols = feature_cols\n",
        "        \n",
        "    def otimizar_preco_assento(self, contexto_voo, preco_min=250.0, preco_max=1800.0, num_passos=150):\n",
        "        \"\"\"\n",
        "        Calcula o preço ótimo que maximiza a Receita Esperada E[R] = Preço * P(Compra).\n",
        "        \"\"\"\n",
        "        # 1. Gerar grid de tarifas candidatas\n",
        "        precos_candidatos = np.linspace(preco_min, preco_max, num_passos)\n",
        "        \n",
        "        # 2. Criar matriz de cenários replicando o contexto para cada preço candidato\n",
        "        cenarios = []\n",
        "        for p in precos_candidatos:\n",
        "            cenario = contexto_voo.copy()\n",
        "            cenario['preco_ofertado'] = p\n",
        "            cenarios.append([cenario[col] for col in self.feature_cols])\n",
        "            \n",
        "        cenarios_df = pd.DataFrame(cenarios, columns=self.feature_cols)\n",
        "        \n",
        "        # 3. Normalização e Inferência Batch na Rede Neural\n",
        "        cenarios_scaled = self.scaler.transform(cenarios_df)\n",
        "        probabilidades_compra = self.modelo.predict(cenarios_scaled, verbose=0).flatten()\n",
        "        \n",
        "        # 4. Cálculo da Receita Esperada por Assento\n",
        "        receitas_esperadas = precos_candidatos * probabilidades_compra\n",
        "        \n",
        "        # 5. Seleção da Tarifa Ótima\n",
        "        idx_otimo = np.argmax(receitas_esperadas)\n",
        "        preco_otimo = precos_candidatos[idx_otimo]\n",
        "        prob_otima = probabilidades_compra[idx_otimo]\n",
        "        receita_otima = receitas_esperadas[idx_otimo]\n",
        "        \n",
        "        return {\n",
        "            'preco_otimo': np.round(preco_otimo, 2),\n",
        "            'probabilidade_conversao': np.round(prob_otima, 4),\n",
        "            'receita_esperada_maxima': np.round(receita_otima, 2),\n",
        "            'grid_precos': precos_candidatos,\n",
        "            'grid_probabilidades': probabilidades_compra,\n",
        "            'grid_receitas': receitas_esperadas\n",
        "        }\n",
        "\n",
        "# Instanciação do Agente\n",
        "agente_ia = AgenteYieldManagement(modelo_mlp, scaler, feature_cols)\n",
        "print(\"Agente de IA para Yield Management compilado e operacional!\")\n"
